# =============================================================================
# Freebox Proxy - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Freebox API base URL (default works for all Freebox on local network)
FREEBOX_URL=http://mafreebox.freebox.fr

# Freebox API version
FREEBOX_API_VERSION=v4

# Path where the app_token is persisted inside the container
TOKEN_FILE=/data/app_token.json

# App identification shown on Freebox LCD during registration
APP_ID=fr.freebox.proxy
APP_NAME=Freebox Proxy
APP_VERSION=1.0
DEVICE_NAME=Docker Server

# Port the proxy listens on
LISTEN_PORT=5656

# Watchdog - Auto-reboot Freebox when internet drops
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL=60
WATCHDOG_CHECK_IPS=8.8.8.8,1.1.1.1
WATCHDOG_FREEBOX_IP=192.168.1.254
WATCHDOG_FAILURES_BEFORE_REBOOT=3
WATCHDOG_COOLDOWN=300
